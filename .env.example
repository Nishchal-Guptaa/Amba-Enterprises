# ==========================================
# Amba Enterprises - Environment Variables
# ==========================================

# ------------------------------------------
# 1. Supabase Configuration
# ------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (safe for frontend browser)
SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO FRONTEND/BROWSER)
# Required by the backend to generate recovery links and manage users
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# 2. Server & Client URLs
# ------------------------------------------
PORT=3001
VITE_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/update-password

# Optional: Set to 'true' to use direct token_hash links (?token_hash=...)
# instead of Supabase action_link
PASSWORD_RESET_USE_DIRECT_LINK=false

# ------------------------------------------
# 3. Custom Email (SMTP) Configuration
# ------------------------------------------
# Configure your email credentials below so that password reset
# and notification emails are sent directly from your own mail address
# with the branded Amba Enterprises template.

# Option A: Standard SMTP (Hostinger, cPanel, Custom Domain, AWS SES, Brevo, Resend)
SMTP_HOST=smtp.yourmailserver.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=orders@ambaenterprises.com
SMTP_PASSWORD=your_email_password
SMTP_FROM="Amba Enterprises <orders@ambaenterprises.com>"

# Option B: Gmail (Requires Google App Password)
# If using Gmail, you can either set SMTP_SERVICE=gmail or use smtp.gmail.com:
# SMTP_SERVICE=gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=youraccount@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx  # 16-character Google App Password (not your normal Gmail password)
# SMTP_FROM="Amba Enterprises <youraccount@gmail.com>"
