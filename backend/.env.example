# ==========================================
# Amba Enterprises Backend - Environment Variables
# ==========================================

PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/update-password
PASSWORD_RESET_USE_DIRECT_LINK=false

# SMTP Configuration
# Standard SMTP:
SMTP_HOST=smtp.yourmailserver.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=orders@ambaenterprises.com
SMTP_PASSWORD=your_email_password
SMTP_FROM="Amba Enterprises <orders@ambaenterprises.com>"

# Or Gmail (using 16-character App Password):
# SMTP_SERVICE=gmail
# SMTP_USER=youraccount@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM="Amba Enterprises <youraccount@gmail.com>"
